# --- Required in production (Railway will inject the ones marked AUTO) ---

FLASK_APP=flask_app.py
FLASK_ENV=production                      # use "development" for local dev
SECRET_KEY=change-me-to-a-long-random-string

# Database (AUTO on Railway when you add the Postgres plugin — DATABASE_URL is injected)
# Local dev falls back to sqlite:///instance/satsimilator.db when unset.
DATABASE_URL=

# Redis / Celery (AUTO on Railway when you add the Redis plugin — REDIS_URL is injected)
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Optional integrations ---

# LLM extraction — pick one. Priority: Gemini > Anthropic > heuristic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
INGEST_PROMPT_VERSION=v1

# Stripe (dev "grant Pro" button is used when unset)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# S3-compatible storage (local filesystem is used when unset)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# Google OAuth (for Sheets / Calendar sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Injected by Railway automatically (do NOT set manually) ---
# PORT     — Railway sets this; gunicorn.conf.py picks it up
